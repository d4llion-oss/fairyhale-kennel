# Copy to .env for local development (never commit .env)
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://fairyhale:fairyhale@localhost:5432/fairyhale
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Used by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Now-1234
SEED_DEMO_DATA=true

# Production (DigitalOcean managed Postgres): provide the CA so TLS is verified
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...
