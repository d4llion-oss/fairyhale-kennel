<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Animals</h1><p class="muted"><%= animals.length %> <%= showAll ? 'total' : 'currently in care' %></p></div>
  <div class="actions">
    <a class="btn btn-secondary" href="/animals<%= showAll ? '' : '?all=1' %>"><%= showAll ? 'Hide archived' : 'Show archived' %></a>
    <a class="btn" href="/animals/new">+ Add animal</a>
  </div>
</div>
<div class="card">
  <% if (!animals.length) { %><p class="muted">No animals yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Name</th><th>Type / breed</th><th>Age</th><th>Diet</th><th>Medications</th><th class="num">Total time</th><th>Last activity</th></tr></thead>
    <tbody>
    <% animals.forEach(a => { %>
      <tr>
        <td><div class="with-avatar"><% if (a.photo_id) { %><img class="avatar" src="/animals/<%= a.id %>/photos/<%= a.photo_id %>?size=thumb" alt=""><% } else { %><span class="avatar-placeholder" aria-hidden="true"></span><% } %><span><a href="/animals/<%= a.id %>"><strong><%= a.name %></strong></a> <% if (!a.is_active) { %><span class="badge badge-neutral">archived</span><% } %></span></div></td>
        <td><%= a.animal_type %><%= a.breed ? ' · ' + a.breed : '' %></td>
        <td><%= h.describeAge(a) %></td>
        <td class="small"><%= a.dietary_requirements || '—' %></td>
        <td class="small"><%= a.medications || '—' %></td>
        <td class="num"><%= h.fmtMinutes(a.total_minutes) %></td>
        <td class="small muted"><%= a.last_activity_at ? h.fmtDateTime(a.last_activity_at) : 'never' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
