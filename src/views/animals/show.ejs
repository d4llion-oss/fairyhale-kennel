<%- include('../partials/head') %>
<div class="page-head">
  <div><h1><%= animal.name %> <% if (!animal.is_active) { %><span class="badge badge-neutral">archived</span><% } %></h1>
  <p class="muted"><%= animal.animal_type %><%= animal.breed ? ' · ' + animal.breed : '' %> · <%= h.describeAge(animal) %></p></div>
  <div class="actions">
    <a class="btn btn-secondary" href="/animals/<%= animal.id %>/edit">Edit profile</a>
    <% if (animal.is_active) { %><a class="btn" href="/activities/new?animal=<%= animal.id %>">+ Log activity</a><% } %>
    <% if (user.role === 'admin') { %>
      <a class="btn btn-secondary" href="/admin/reports?animal=<%= animal.id %>">Report</a>
      <form method="post" action="/animals/<%= animal.id %>/archive" class="inline" data-confirm="<%= animal.is_active ? 'Archive' : 'Restore' %> <%= animal.name %>?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= animal.is_active ? '0' : '1' %>">
        <button class="btn <%= animal.is_active ? 'btn-danger' : 'btn-secondary' %>"><%= animal.is_active ? 'Archive' : 'Restore' %></button>
      </form>
    <% } %>
  </div>
</div>

<div class="card gallery-card">
  <div class="card-head">
    <h2>Photos <span class="muted small" style="font-family:inherit;font-weight:400"><%= photos.length %> of <%= maxPhotos %></span></h2>
    <% if (photos.length < maxPhotos) { %>
    <form method="post" action="/animals/<%= animal.id %>/photos" enctype="multipart/form-data" class="inline upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="btn btn-secondary btn-sm" style="margin:0">
        <input type="file" name="photos" accept="image/*" multiple capture="environment" data-autosubmit hidden>
        + Add photo<%= maxPhotos - photos.length > 1 ? 's' : '' %>
      </label>
      <noscript><button class="btn btn-sm">Upload</button></noscript>
    </form>
    <% } %>
  </div>
  <% if (!photos.length) { %>
    <p class="muted" style="margin:0">No photos yet. Add up to <%= maxPhotos %> — the first one is shown on the dashboard and animal list.</p>
  <% } else { %>
  <div class="gallery" data-gallery>
    <div class="gallery-stage">
      <% if (photos.length > 1) { %><button type="button" class="gallery-nav prev" data-gallery-prev aria-label="Previous photo">‹</button><% } %>
      <% photos.forEach((p, i) => { %>
        <figure class="gallery-slide" data-slide="<%= i %>" <%= i ? 'hidden' : '' %>>
          <a href="/animals/<%= animal.id %>/photos/<%= p.id %>" target="_blank" rel="noopener"><img src="/animals/<%= animal.id %>/photos/<%= p.id %>" alt="<%= p.caption || animal.name + ' photo ' + p.position %>" width="<%= p.width %>" height="<%= p.height %>" loading="<%= i ? 'lazy' : 'eager' %>"></a>
          <figcaption>
            <span><%= p.caption || '' %></span>
            <span class="muted small"><%= i + 1 %> / <%= photos.length %> · <%= h.fmtDate(p.created_at) %></span>
          </figcaption>
        </figure>
      <% }) %>
      <% if (photos.length > 1) { %><button type="button" class="gallery-nav next" data-gallery-next aria-label="Next photo">›</button><% } %>
    </div>
    <div class="gallery-thumbs">
      <% photos.forEach((p, i) => { %>
        <div class="thumb <%= i === 0 ? 'active' : '' %>" data-thumb="<%= i %>">
          <button type="button" class="thumb-btn" data-gallery-go="<%= i %>" aria-label="Show photo <%= i + 1 %>"><img src="/animals/<%= animal.id %>/photos/<%= p.id %>?size=thumb" alt="" width="320" height="320" loading="lazy"></button>
          <details class="thumb-menu"><summary aria-label="Photo options">⋯</summary>
            <div class="dropdown-panel">
              <form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/caption" class="stack" style="gap:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="caption" value="<%= p.caption || '' %>" placeholder="Caption" maxlength="140"><button class="btn btn-sm">Save caption</button></form>
              <% if (i > 0) { %><form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/primary" style="margin-top:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" style="width:100%">Make primary</button></form><% } %>
              <form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/delete" data-confirm="Remove this photo of <%= animal.name %>?" style="margin-top:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" style="width:100%">Remove</button></form>
            </div>
          </details>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<div class="grid grid-2">
  <div class="card">
    <h2>Profile</h2>
    <dl class="props">
      <dt>Age</dt><dd><%= h.describeAge(animal) %><%= animal.date_of_birth ? ' (born ' + h.fmtDate(animal.date_of_birth) + ')' : '' %></dd>
      <dt>Type</dt><dd><%= animal.animal_type %></dd>
      <dt>Breed</dt><dd><%= animal.breed || '—' %></dd>
      <dt>Diet</dt><dd><%= animal.dietary_requirements || '—' %></dd>
      <dt>Medications</dt><dd><%= animal.medications || '—' %></dd>
      <dt>Notes</dt><dd><%= animal.notes || '—' %></dd>
    </dl>
    <p class="small muted" style="margin:1rem 0 0">Added <%= h.fmtDateTime(animal.created_at) %> · updated <%= h.fmtDateTime(animal.updated_at) %></p>
  </div>
  <div class="card">
    <h2>Last 7 days</h2>
    <% if (!totals.length) { %><p class="muted">No activity in the past week.</p><% } else {
      const max = Math.max(...totals.map(t => t.minutes)); const sum = totals.reduce((s,t)=>s+t.minutes,0); %>
    <p class="muted small" style="margin-top:0"><%= h.fmtMinutes(sum) %> across <%= totals.reduce((s,t)=>s+t.n,0) %> entries</p>
    <% totals.forEach(t => { %>
      <div style="margin-bottom:.6rem"><div style="display:flex;justify-content:space-between" class="small"><span><%= t.activity_type %></span><span><%= h.fmtMinutes(t.minutes) %></span></div><div class="bar"><span style="width:<%= Math.round(t.minutes / max * 100) %>%"></span></div></div>
    <% }) } %>
  </div>
</div>

<div class="card" style="margin-top:1rem">
  <h2>Activity history</h2>
  <% if (!entries.length) { %><p class="muted">Nothing logged yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Activity</th><th class="num">Time</th><th>By</th><th>Notes</th><% if (user.role==='admin') { %><th></th><% } %></tr></thead>
    <tbody>
    <% entries.forEach(e => { %>
      <tr><td class="small"><%= h.fmtDateTime(e.performed_at) %></td><td><%= e.activity_type %></td><td class="num"><%= h.fmtMinutes(e.duration_minutes) %></td><td><%= e.user_name %></td><td class="small muted"><%= e.notes || '' %></td>
      <% if (user.role==='admin') { %><td><form method="post" action="/activities/<%= e.id %>/delete" data-confirm="Remove this entry? The removal is recorded in the audit log."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Remove</button></form></td><% } %></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
