<%- include('../partials/head') %>
<div class="page-head">
  <div><h1><%= animal.name %> <% if (!animal.is_active) { %><span class="badge badge-neutral">archived</span><% } %></h1>
  <p class="muted"><%= animal.animal_type %><%= animal.breed ? ' · ' + animal.breed : '' %> · <%= h.describeAge(animal) %></p></div>
  <div class="actions">
    <a class="btn btn-secondary" href="/animals/<%= animal.id %>/edit">Edit profile</a>
    <% if (animal.is_active) { %><a class="btn" href="/activities/new?animal=<%= animal.id %>">+ Log activity</a><% } %>
    <% if (user.role === 'admin') { %>
      <a class="btn btn-secondary" href="/admin/reports?animal=<%= animal.id %>">Report</a>
      <form method="post" action="/animals/<%= animal.id %>/archive" class="inline" data-confirm="<%= animal.is_active ? 'Archive' : 'Restore' %> <%= animal.name %>?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= animal.is_active ? '0' : '1' %>">
        <button class="btn <%= animal.is_active ? 'btn-danger' : 'btn-secondary' %>"><%= animal.is_active ? 'Archive' : 'Restore' %></button>
      </form>
    <% } %>
  </div>
</div>

<div class="card gallery-card">
  <div class="card-head">
    <h2>Photos <span class="muted small" style="font-family:inherit;font-weight:400"><%= photos.length %> of <%= maxPhotos %></span></h2>
    <% if (photos.length < maxPhotos) { %>
    <form method="post" action="/animals/<%= animal.id %>/photos" enctype="multipart/form-data" class="inline upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="btn btn-secondary btn-sm" style="margin:0" title="Choose from your photos or files">
        <input type="file" name="photos" accept="image/*" multiple data-autosubmit hidden>
        + Add photo<%= maxPhotos - photos.length > 1 ? 's' : '' %>
      </label>
      <label class="btn btn-secondary btn-sm mobile-only" style="margin:0 0 0 .4rem" title="Take a photo with the camera">
        <input type="file" name="photos" accept="image/*" capture="environment" data-autosubmit hidden>
        📷 Take photo
      </label>
      <noscript><button class="btn btn-sm">Upload</button></noscript>
    </form>
    <% } %>
  </div>
  <% if (!photos.length) { %>
    <p class="muted" style="margin:0">No photos yet. Add up to <%= maxPhotos %> — the first one is shown on the dashboard and animal list.</p>
  <% } else { %>
  <div class="gallery" data-gallery>
    <div class="gallery-stage">
      <% if (photos.length > 1) { %><button type="button" class="gallery-nav prev" data-gallery-prev aria-label="Previous photo">‹</button><% } %>
      <% photos.forEach((p, i) => { %>
        <figure class="gallery-slide" data-slide="<%= i %>" <%= i ? 'hidden' : '' %>>
          <a href="/animals/<%= animal.id %>/photos/<%= p.id %>" target="_blank" rel="noopener"><img src="/animals/<%= animal.id %>/photos/<%= p.id %>" alt="<%= p.caption || animal.name + ' photo ' + p.position %>" width="<%= p.width %>" height="<%= p.height %>" loading="<%= i ? 'lazy' : 'eager' %>"></a>
          <figcaption>
            <span><%= p.caption || '' %></span>
            <span class="muted small"><%= i + 1 %> / <%= photos.length %> · <%= h.fmtDate(p.created_at) %></span>
          </figcaption>
        </figure>
      <% }) %>
      <% if (photos.length > 1) { %><button type="button" class="gallery-nav next" data-gallery-next aria-label="Next photo">›</button><% } %>
    </div>
    <div class="gallery-thumbs">
      <% photos.forEach((p, i) => { %>
        <div class="thumb <%= i === 0 ? 'active' : '' %>" data-thumb="<%= i %>">
          <button type="button" class="thumb-btn" data-gallery-go="<%= i %>" aria-label="Show photo <%= i + 1 %>"><img src="/animals/<%= animal.id %>/photos/<%= p.id %>?size=thumb" alt="" loading="lazy"></button>
          <details class="thumb-menu"><summary aria-label="Photo options">⋯</summary>
            <div class="dropdown-panel">
              <form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/caption" class="stack" style="gap:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="caption" value="<%= p.caption || '' %>" placeholder="Caption" maxlength="140"><button class="btn btn-sm">Save caption</button></form>
              <% if (i > 0) { %><form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/primary" style="margin-top:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" style="width:100%">Make primary</button></form><% } %>
              <form method="post" action="/animals/<%= animal.id %>/photos/<%= p.id %>/delete" data-confirm="Remove this photo of <%= animal.name %>?" style="margin-top:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm" style="width:100%">Remove</button></form>
            </div>
          </details>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<div class="grid grid-2">
  <div class="card">
    <h2>Profile</h2>
    <dl class="props">
      <dt>Age</dt><dd><%= h.describeAge(animal) %><%= animal.date_of_birth ? ' (born ' + h.fmtDate(animal.date_of_birth) + ')' : '' %></dd>
      <dt>Type</dt><dd><%= animal.animal_type %></dd>
      <dt>Breed</dt><dd><%= animal.breed || '—' %></dd>
      <dt>Diet</dt><dd><%= animal.dietary_requirements || '—' %></dd>
      <dt>Medication notes</dt><dd><%= animal.medications || '—' %></dd>
      <dt>Notes</dt><dd><%= animal.notes || '—' %></dd>
    </dl>

    <div class="conditions" id="conditions">
      <h3>Medical conditions</h3>
      <% if (!conditions.length) { %><p class="muted small" style="margin:.2rem 0 .6rem">None recorded.</p><% } else { %>
      <ul class="cond-list">
        <% conditions.forEach(c => { %>
          <li>
            <button type="button" class="cond-chip" data-summary="/conditions/summary" data-condition="<%= c.name %>" data-wiki="<%= c.wiki_title || '' %>" title="Show a summary of <%= c.name %>"><%= c.name %></button>
            <% if (c.notes) { %><span class="muted small"><%= c.notes %></span><% } %>
            <form method="post" action="/animals/<%= animal.id %>/conditions/<%= c.id %>/delete" class="inline" data-confirm="Remove &quot;<%= c.name %>&quot; from <%= animal.name %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-btn" aria-label="Remove <%= c.name %>">×</button></form>
          </li>
        <% }) %>
      </ul>
      <% } %>
      <form method="post" action="/animals/<%= animal.id %>/conditions" class="cond-form" autocomplete="off" data-ac-form data-ac-url="/conditions/suggest">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="wiki" value="">
        <div class="autocomplete">
          <input type="text" name="name" placeholder="Add a condition — start typing, e.g. hip dys…" maxlength="120" required aria-label="Condition name" aria-autocomplete="list" aria-expanded="false" data-ac-input>
          <ul class="ac-list" role="listbox" hidden></ul>
        </div>
        <input type="text" name="notes" placeholder="Note (optional)" maxlength="140" aria-label="Note">
        <button class="btn btn-sm">Add</button>
      </form>
      <p class="help">Click a condition for a reference summary. Summaries are general information, not veterinary advice.</p>
    </div>
    <p class="small muted" style="margin:1rem 0 0">Added <%= h.fmtDateTime(animal.created_at) %> · updated <%= h.fmtDateTime(animal.updated_at) %></p>
  </div>
  <div class="card">
    <h2>Last 7 days</h2>
    <% if (!totals.length) { %><p class="muted">No activity in the past week.</p><% } else {
      const max = Math.max(...totals.map(t => t.minutes)); const sum = totals.reduce((s,t)=>s+t.minutes,0); %>
    <p class="muted small" style="margin-top:0"><%= h.fmtMinutes(sum) %> across <%= totals.reduce((s,t)=>s+t.n,0) %> entries</p>
    <% totals.forEach(t => { %>
      <div style="margin-bottom:.6rem"><div style="display:flex;justify-content:space-between" class="small"><span><%= t.activity_type %></span><span><%= h.fmtMinutes(t.minutes) %></span></div><div class="bar"><span style="width:<%= Math.round(t.minutes / max * 100) %>%"></span></div></div>
    <% }) } %>
  </div>
</div>

<div class="card" id="medications" style="margin-top:1rem">
  <div class="card-head"><h2>Medications</h2><span class="muted small"><%= medications.filter(m => m.is_active).length %> active · today in <%= 'America/Chicago' %></span></div>
  <% const activeMeds = medications.filter(m => m.is_active), stoppedMeds = medications.filter(m => !m.is_active); %>
  <% if (!activeMeds.length) { %><p class="muted small" style="margin:.2rem 0 .8rem">No active medications.</p><% } else { %>
  <div class="table-wrap"><table class="meds">
    <thead><tr><th>Medication</th><th>Dose · frequency</th><th>Given today</th><th>Notes</th><th></th></tr></thead>
    <tbody>
    <% activeMeds.forEach(m => { const given = m.today.length; const boxes = Math.max(m.expectedToday, given); %>
      <tr>
        <td><button type="button" class="cond-chip" data-summary="/medications/summary" data-condition="<%= m.name %>" data-wiki="<%= m.wiki_title || '' %>" title="Show a summary of <%= m.name %>"><%= m.name %></button>
          <div class="small muted">last given <%= m.last_given_at ? h.fmtDateTime(m.last_given_at) : 'never' %></div></td>
        <td><%= m.dose || '' %><div class="small muted"><%= m.freq.label %></div></td>
        <td>
          <div class="dose-boxes">
            <% for (let i = 0; i < boxes; i++) { const d = m.today[i]; %>
              <% if (d) { %>
                <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/doses/<%= d.id %>/delete" class="inline dose" data-confirm="Undo this dose of <%= m.name %>?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="check given" title="Given <%= new Date(d.given_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) %> by <%= d.given_by || '—' %><%= d.notes ? ' — ' + d.notes : '' %>">
                    <input type="checkbox" checked data-autosubmit> <span class="small"><%= new Date(d.given_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) %></span></label>
                </form>
              <% } else { %>
                <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/doses" class="inline dose">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="check" title="Mark dose <%= i + 1 %> of <%= m.expectedToday %> as given now"><input type="checkbox" data-autosubmit> <span class="small muted">dose <%= i + 1 %></span></label>
                </form>
              <% } %>
            <% } %>
            <% if (m.frequency === 'as_needed' || given >= m.expectedToday) { %>
              <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/doses" class="inline dose"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-sm" title="Record an extra dose">+ dose</button></form>
            <% } %>
          </div>
          <% if (m.expectedToday && given < m.expectedToday) { %><div class="small" style="color:var(--amber)"><%= m.expectedToday - given %> remaining</div><% } else if (m.expectedToday) { %><div class="small" style="color:var(--green-ink)">complete</div><% } %>
        </td>
        <td class="small muted"><%= m.notes || '' %></td>
        <td style="white-space:nowrap">
          <details class="thumb-menu" style="position:static;display:inline-block"><summary class="btn btn-secondary btn-sm" style="list-style:none">Edit ▾</summary>
            <div class="dropdown-panel" style="right:0;left:auto;min-width:260px">
              <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/notes" class="stack" style="gap:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="text" name="dose" value="<%= m.dose || '' %>" placeholder="Dose (e.g. 50 mg)" maxlength="60">
                <select name="frequency"><% Object.entries(medFrequencies).forEach(([k, f]) => { %><option value="<%= k %>" <%= m.frequency === k ? 'selected' : '' %>><%= f.label %></option><% }) %></select>
                <input type="text" name="notes" value="<%= m.notes || '' %>" placeholder="Notes (with food, etc.)" maxlength="200">
                <button class="btn btn-sm">Save</button></form>
              <a class="btn btn-secondary btn-sm" style="width:100%;margin-top:.4rem;text-align:center" href="/animals/<%= animal.id %>/medications/<%= m.id %>/history">Dose history (<%= m.dose_count %>)</a>
              <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/active" style="margin-top:.4rem"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="0"><button class="btn btn-danger btn-sm" style="width:100%">Stop medication</button></form>
            </div>
          </details>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
  <% if (stoppedMeds.length) { %>
  <details style="margin:.5rem 0"><summary>Stopped medications (<%= stoppedMeds.length %>)</summary>
    <ul class="list" style="margin-top:.4rem">
      <% stoppedMeds.forEach(m => { %>
      <li><div><button type="button" class="cond-chip" data-summary="/medications/summary" data-condition="<%= m.name %>" data-wiki="<%= m.wiki_title || '' %>"><%= m.name %></button> <span class="muted small"><%= m.dose || '' %> · <%= m.freq.label %> · stopped <%= h.fmtDate(m.ended_at) %> · <%= m.dose_count %> dose<%= m.dose_count === 1 ? '' : 's' %> recorded</span></div>
        <div class="actions">
          <a class="btn btn-secondary btn-sm" href="/animals/<%= animal.id %>/medications/<%= m.id %>/history">History</a>
          <form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/active" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="1"><button class="btn btn-secondary btn-sm">Resume</button></form>
          <% if (!m.dose_count) { %><form method="post" action="/animals/<%= animal.id %>/medications/<%= m.id %>/delete" class="inline" data-confirm="Delete <%= m.name %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Delete</button></form><% } %>
        </div></li>
      <% }) %>
    </ul>
  </details>
  <% } %>
  <form method="post" action="/animals/<%= animal.id %>/medications" class="med-form" autocomplete="off" data-ac-form data-ac-url="/medications/suggest">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="wiki" value="">
    <div class="autocomplete"><input type="text" name="name" placeholder="Add a medication — start typing, e.g. carpro…" maxlength="120" required aria-label="Medication name" aria-autocomplete="list" aria-expanded="false" data-ac-input><ul class="ac-list" role="listbox" hidden></ul></div>
    <input type="text" name="dose" placeholder="Dose (e.g. 50 mg)" maxlength="60" aria-label="Dose">
    <select name="frequency" aria-label="Frequency"><% Object.entries(medFrequencies).forEach(([k, f]) => { %><option value="<%= k %>" <%= k === 'once_daily' ? 'selected' : '' %>><%= f.label %></option><% }) %></select>
    <input type="text" name="notes" placeholder="Notes (optional)" maxlength="200" aria-label="Notes">
    <button class="btn btn-sm">Add</button>
  </form>
  <p class="help">Tick a box each time a dose is given; it records who gave it and when. Click a medication name for a reference summary (general information, not veterinary advice).</p>
</div>

<div class="card" style="margin-top:1rem">
  <h2>Activity history</h2>
  <% if (!entries.length) { %><p class="muted">Nothing logged yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Activity</th><th class="num">Time</th><th>By</th><th>Notes</th><% if (user.role==='admin') { %><th></th><% } %></tr></thead>
    <tbody>
    <% entries.forEach(e => { %>
      <tr><td class="small"><%= h.fmtDateTime(e.performed_at) %></td><td><%= e.activity_type %></td><td class="num"><%= h.fmtMinutes(e.duration_minutes) %></td><td><%= e.user_name %></td><td class="small muted"><%= e.notes || '' %></td>
      <% if (user.role==='admin') { %><td><form method="post" action="/activities/<%= e.id %>/delete" data-confirm="Remove this entry? The removal is recorded in the audit log."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Remove</button></form></td><% } %></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
