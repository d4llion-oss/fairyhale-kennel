<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Audit log</h1><p class="muted"><%= total %> entries · append-only; timestamps are assigned by the database and cannot be edited or deleted.</p></div>
  <div class="actions"><a class="btn btn-secondary" href="/admin/audit/export.csv">Export CSV</a></div>
</div>
<div class="card">
  <form method="get" action="/admin/audit" class="row row-3" style="margin-bottom:1rem;align-items:end">
    <div><label>Entity</label><select name="entity"><option value="">All</option><% entities.forEach(e => { %><option <%= query.entity===e?'selected':'' %>><%= e %></option><% }) %></select></div>
    <div><label>User</label><select name="user"><option value="">All</option><% users.forEach(u => { %><option <%= query.user===u?'selected':'' %>><%= u %></option><% }) %></select></div>
    <div><label>Search summary</label><div style="display:flex;gap:.5rem"><input type="text" name="q" value="<%= query.q %>"><button class="btn">Filter</button></div></div>
  </form>
  <div class="table-wrap"><table>
    <thead><tr><th>#</th><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Summary</th><th>IP</th></tr></thead>
    <tbody>
    <% entries.forEach(e => { %>
      <tr>
        <td class="muted small"><%= e.id %></td>
        <td class="small" style="white-space:nowrap"><%= new Date(e.occurred_at).toISOString().replace('T',' ').replace(/\.\d+Z$/,' Z') %></td>
        <td><%= e.username || '—' %></td>
        <td><span class="badge badge-type"><%= e.action %></span></td>
        <td class="small"><%= e.entity_type %></td>
        <td><%= e.summary %>
          <% if (e.before_data || e.after_data) { %><details><summary>details</summary>
            <% if (e.before_data) { %><div class="small muted">Before</div><pre class="json"><%= JSON.stringify(e.before_data, null, 1) %></pre><% } %>
            <% if (e.after_data) { %><div class="small muted">After</div><pre class="json"><%= JSON.stringify(e.after_data, null, 1) %></pre><% } %>
          </details><% } %></td>
        <td class="small muted"><%= e.ip_address || '' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% if (pages > 1) { const qs = (p) => `?page=${p}&entity=${encodeURIComponent(query.entity)}&user=${encodeURIComponent(query.user)}&q=${encodeURIComponent(query.q)}`; %>
  <div class="pager">
    <% if (page > 1) { %><a class="btn btn-secondary btn-sm" href="<%= qs(page-1) %>">← Newer</a><% } %>
    <span class="muted small">Page <%= page %> of <%= pages %></span>
    <% if (page < pages) { %><a class="btn btn-secondary btn-sm" href="<%= qs(page+1) %>">Older →</a><% } %>
  </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
