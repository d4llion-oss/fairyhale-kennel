<%- include('../partials/head') %>
<% const bulk = entry.mode === 'bulk'; const selectedIds = new Set(entry.animal_ids || []);
   const typeGroups = [...new Set(animals.map(a => a.animal_type))]; %>
<div class="page-head"><div><h1>Log activity</h1><p class="muted">Record time spent with an animal. The entry is stamped with the server time when saved.</p></div></div>
<div class="card" style="max-width:720px">
  <% if (errors.length) { %><div class="errors"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <% if (!animals.length) { %><p class="muted">There are no active animals. <a href="/animals/new">Add one first.</a></p><% } else { %>
  <form method="post" action="/activities" class="stack" id="activity-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="return_to" value="<%= entry.animal_id ? 'animal' : 'list' %>">

    <div>
      <label>Log for</label>
      <div class="mode" role="radiogroup">
        <label><input type="radio" name="mode" value="single" <%= bulk ? '' : 'checked' %>><span>One animal</span></label>
        <label><input type="radio" name="mode" value="bulk" <%= bulk ? 'checked' : '' %>><span>All selected animals</span></label>
      </div>
    </div>

    <div id="single-picker" <%= bulk ? 'hidden' : '' %>>
      <label for="animal_id">Animal</label>
      <select id="animal_id" name="animal_id">
        <option value="">Select…</option>
        <% animals.forEach(a => { %><option value="<%= a.id %>" <%= entry.animal_id === a.id ? 'selected' : '' %>><%= a.name %> (<%= a.animal_type %>)</option><% }) %>
      </select>
    </div>

    <div id="bulk-picker" <%= bulk ? '' : 'hidden' %>>
      <label>Animals <span class="opt">(<span id="picked-count"><%= selectedIds.size %></span> selected)</span></label>
      <div class="picker-tools">
        <button type="button" class="btn btn-secondary btn-sm" data-pick="all">Select all</button>
        <button type="button" class="btn btn-secondary btn-sm" data-pick="none">Clear</button>
        <% typeGroups.forEach(t => { %><button type="button" class="btn btn-secondary btn-sm" data-pick-type="<%= t %>">All <%= t.toLowerCase() %>s</button><% }) %>
      </div>
      <div class="picker">
        <% animals.forEach(a => { %>
          <label class="check"><input type="checkbox" name="animal_ids" value="<%= a.id %>" data-type="<%= a.animal_type %>" <%= selectedIds.has(a.id) ? 'checked' : '' %>> <%= a.name %> <span class="muted small"><%= a.animal_type %></span></label>
        <% }) %>
      </div>
      <div class="help">One entry is created per animal, each with its own audit record.</div>
    </div>

    <div class="row">
      <div><label for="activity_type">Activity</label>
        <select id="activity_type" name="activity_type" required>
          <option value="">Select…</option>
          <% types.forEach(t => { %><option <%= entry.activity_type === t ? 'selected' : '' %>><%= t %></option><% }) %>
        </select></div>
      <div><label for="duration_minutes">Duration (minutes) <span class="opt">per animal</span></label><input id="duration_minutes" name="duration_minutes" type="number" min="1" max="1440" value="<%= entry.duration_minutes || '' %>" required>
        <div class="actions" style="margin-top:.4rem">
          <% [5,10,15,30,45,60].forEach(m => { %><button type="button" class="btn btn-secondary btn-sm" data-set-duration="<%= m %>"><%= m %></button><% }) %>
        </div></div>
    </div>
    <div class="row">
      <div><label for="performed_at">When <span class="opt">(blank = now)</span></label><input id="performed_at" name="performed_at" type="datetime-local" value="<%= entry.performed_at ? new Date(entry.performed_at).toISOString().slice(0,16) : '' %>"></div>
      <div><label for="notes">Notes <span class="opt">(optional)</span></label><textarea id="notes" name="notes" style="min-height:44px" placeholder="Ate all food, took meds without issue…"><%= entry.notes || '' %></textarea></div>
    </div>
    <div class="actions"><button class="btn" id="submit-btn">Save entry</button><a class="btn btn-secondary" href="<%= entry.animal_id ? '/animals/' + entry.animal_id : '/activities' %>">Cancel</a></div>
  </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
