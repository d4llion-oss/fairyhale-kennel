<%- include('../partials/head') %>
<div class="page-head">
  <div><h1>Activity log</h1><p class="muted"><%= mine ? 'Your entries' : 'All staff entries' %> · most recent 200</p></div>
  <div class="actions">
    <a class="btn btn-secondary" href="/activities<%= mine ? '' : '?mine=1' %>"><%= mine ? 'Show everyone' : 'Just mine' %></a>
    <a class="btn" href="/activities/new">+ Log activity</a>
  </div>
</div>
<div class="card">
  <% if (!entries.length) { %><p class="muted">No entries yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>When</th><th>Animal</th><th>Activity</th><th class="num">Time</th><th>By</th><th>Notes</th><th>Recorded</th><% if (user.role==='admin') { %><th></th><% } %></tr></thead>
    <tbody>
    <% entries.forEach(e => { %>
      <tr><td class="small"><%= h.fmtDateTime(e.performed_at) %></td><td><a href="/animals/<%= e.animal_id %>"><%= e.animal_name %></a></td><td><%= e.activity_type %></td><td class="num"><%= h.fmtMinutes(e.duration_minutes) %></td><td><%= e.user_name %></td><td class="small muted"><%= e.notes || '' %></td><td class="small muted"><%= h.fmtDateTime(e.created_at) %></td>
      <% if (user.role==='admin') { %><td><form method="post" action="/activities/<%= e.id %>/delete" data-confirm="Remove this entry? The removal is recorded in the audit log."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Remove</button></form></td><% } %></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
