<%- include('partials/head') %>
<div class="page-head">
  <div><h1>Good <%= new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 17 ? 'afternoon' : 'evening' %>, <%= user.displayName.split(' ')[0] %></h1>
  <p class="muted"><%= h.fmtDate(new Date()) %></p></div>
  <div class="actions"><a class="btn" href="/activities/new">+ Log activity</a></div>
</div>

<div class="stats">
  <div class="stat"><div class="n"><%= animals.length %></div><div class="l"><%= selectedTypes.length ? selectedTypes.join(' / ') + ' in care' : 'Animals in care' %></div></div>
  <div class="stat"><div class="n"><%= h.fmtMinutes(today.minutes) %></div><div class="l">Logged today<span class="desk"> · <%= today.entries %> entries</span></div></div>
  <div class="stat"><div class="n" style="color:<%= dueTasks.filter(t=>t.status==='overdue').length ? 'var(--red)' : 'var(--green-ink)' %>"><%= dueTasks.length %></div><div class="l">Tasks due<span class="desk"> · of <%= taskCount %></span></div></div>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-head">
      <h2>Animals</h2>
      <% if (availableTypes.length > 1) { %>
      <form method="get" action="/" class="filter" data-autosubmit>
        <details class="dropdown">
          <summary class="btn btn-secondary btn-sm">
            <%= selectedTypes.length ? selectedTypes.join(', ') : 'All types' %> ▾
          </summary>
          <div class="dropdown-panel">
            <% availableTypes.forEach(t => { %>
              <label class="check"><input type="checkbox" name="type" value="<%= t.animal_type %>" <%= selectedTypes.includes(t.animal_type) ? 'checked' : '' %>> <%= t.animal_type %> <span class="muted">(<%= t.n %>)</span></label>
            <% }) %>
            <div class="dropdown-actions">
              <button class="btn btn-sm" type="submit">Apply</button>
              <% if (selectedTypes.length) { %><a class="btn btn-secondary btn-sm" href="/">Clear</a><% } %>
            </div>
          </div>
        </details>
      </form>
      <% } %>
    </div>
    <% if (!animals.length && selectedTypes.length) { %><p class="muted">No active animals of that type. <a href="/">Show all.</a></p>
    <% } else if (!animals.length) { %><p class="muted">No animals yet. <a href="/animals/new">Add the first one.</a></p><% } else { %>
    <ul class="list">
      <% animals.forEach(a => { %>
      <li>
        <div class="with-avatar"><a class="avatar-link" href="/animals/<%= a.id %>" title="Open <%= a.name %>'s profile"><% if (a.photo_id) { %><span class="avatar-box"><img src="/animals/<%= a.id %>/photos/<%= a.photo_id %>?size=thumb" alt="<%= a.name %>" width="75" height="75"></span><% } else { %><span class="avatar-placeholder"></span><% } %></a>
          <div><a href="/animals/<%= a.id %>"><strong><%= a.name %></strong></a> <span class="muted small"><%= a.animal_type %><%= a.breed ? ' · ' + a.breed : '' %></span>
          <% if (a.medications) { %><div class="small muted">💊 <%= a.medications %></div><% } %>
          <% if (a.groups && a.groups.length) { %><div style="margin-top:.2rem"><% a.groups.forEach(g => { %><span class="pg-badge pg-<%= g.color %>" style="font-size:.7rem;padding:.1rem .5rem;margin-right:.25rem"><%= g.name %></span><% }) %></div><% } %></div></div>
        <div style="text-align:right;white-space:nowrap">
          <div class="small"><% if (a.minutes_today) { %><%= h.fmtMinutes(a.minutes_today) %> today<% } else { %><span class="muted">nothing today</span><% } %></div>
          <a class="btn btn-secondary btn-sm" href="/activities/new?animal=<%= a.id %>">Log</a>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>

  <div class="card">
    <h2>Tasks due</h2>
    <% if (!dueTasks.length) { %><p class="muted">Everything is on schedule. <a href="/tasks">See all tasks.</a></p><% } else { %>
    <ul class="list">
      <% dueTasks.forEach(t => { %>
      <li>
        <div><strong><%= t.title %></strong> <span class="badge badge-<%= t.status %>"><%= t.status === 'overdue' ? 'Overdue' : 'Due soon' %></span>
          <div class="small muted"><%= h.FREQUENCIES[t.frequency] %><%= t.last_completed_at ? ' · last ' + h.fmtDateTime(t.last_completed_at) : ' · never completed' %></div></div>
        <form method="post" action="/tasks/<%= t.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="dashboard"><button class="btn btn-sm">Done</button></form>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</div>

<% const fmtT = (ts) => new Date(ts).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' });
   const ago = (ts) => { const m = Math.round((Date.now() - new Date(ts).getTime()) / 60000); return m < 60 ? m + ' min ago' : m < 1440 ? Math.round(m / 60) + ' h ago' : Math.round(m / 1440) + ' d ago'; };
   const withMembers = pottyGroups.filter(g => g.members.length);
   const nextIdx = withMembers.findIndex(g => !g.last_outing || (Date.now() - new Date(g.last_outing.at).getTime()) > 4 * 3600000); %>
<div class="card" id="potty-rotation" style="margin-top:1rem">
  <div class="card-head">
    <h2>Potty rotation</h2>
    <a class="btn btn-secondary btn-sm" href="/potty-groups">Manage groups</a>
  </div>
  <% if (!withMembers.length) { %>
    <p class="muted" style="margin:0">No potty groups with animals yet. <a href="/potty-groups">Set up groups</a> to see the let-out order here.</p>
  <% } else { %>
  <p class="muted small" style="margin:0 0 .6rem">Let groups out in this order. Tap <strong>Let out</strong> when a group goes out; the time and who did it are recorded.</p>
  <ol class="rotation">
    <% withMembers.forEach((g, i) => { const stale = !g.last_outing || (Date.now() - new Date(g.last_outing.at).getTime()) > 4 * 3600000; %>
      <li class="rotation-row <%= i === nextIdx ? 'next' : '' %>">
        <div class="rotation-num"><%= i + 1 %></div>
        <div class="rotation-main">
          <div class="rotation-title"><span class="pg-badge pg-<%= g.color %>"><%= g.name %></span>
            <% if (i === nextIdx) { %><span class="badge badge-due_soon">Up next</span><% } %>
            <% if (g.notes) { %><span class="muted small"><%= g.notes %></span><% } %></div>
          <div class="rotation-members">
            <% g.members.forEach(m => { %>
              <a href="/animals/<%= m.id %>" class="rotation-member" title="<%= m.animal_type %><%= m.breed ? ' · ' + m.breed : '' %>">
                <% if (m.photo_id) { %><span class="avatar-box avatar-sm"><img src="/animals/<%= m.id %>/photos/<%= m.photo_id %>?size=thumb" alt=""></span><% } else { %><span class="avatar-placeholder avatar-sm"></span><% } %>
                <span><%= m.name %></span></a>
            <% }) %>
          </div>
          <div class="small <%= stale ? 'muted' : '' %>" style="margin-top:.25rem;<%= stale ? '' : 'color:var(--green-ink)' %>">
            <% if (g.last_outing) { %>Last out <%= fmtT(g.last_outing.at) %> (<%= ago(g.last_outing.at) %>)<%= g.last_outing.by ? ' by ' + g.last_outing.by : '' %> · <%= g.outings_today %>× today<% } else { %>Not let out yet today<% } %>
          </div>
        </div>
        <div class="rotation-actions">
          <form method="post" action="/potty-groups/<%= g.id %>/let-out"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm">Let out</button></form>
          <div class="reorder">
            <form method="post" action="/potty-groups/<%= g.id %>/move" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up"><input type="hidden" name="return_to" value="dashboard"><button class="link-btn" <%= i === 0 ? 'disabled' : '' %> aria-label="Move up" title="Move up">▲</button></form>
            <form method="post" action="/potty-groups/<%= g.id %>/move" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down"><input type="hidden" name="return_to" value="dashboard"><button class="link-btn" <%= i === withMembers.length - 1 ? 'disabled' : '' %> aria-label="Move down" title="Move down">▼</button></form>
          </div>
        </div>
      </li>
    <% }) %>
  </ol>
  <% } %>
</div>

<div class="card" style="margin-top:1rem">
  <h2>Recent activity</h2>
  <% if (!recent.length) { %><p class="muted">No activity logged yet.</p><% } else { %>
  <div class="table-wrap"><table class="stack">
    <thead><tr><th>Entry</th><th>When</th><th>By</th><th>Notes</th></tr></thead>
    <tbody>
    <% recent.forEach(e => { %>
      <tr><td class="primary"><a href="/animals/<%= e.animal_id %>"><%= e.animal_name %></a> · <%= e.activity_type %> · <%= h.fmtMinutes(e.duration_minutes) %></td><td class="small" data-label="When"><%= h.fmtDateTime(e.performed_at) %></td><td data-label="By"><%= e.user_name %></td><td class="small muted" data-label="Notes"><%= e.notes || '' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('partials/foot') %>
