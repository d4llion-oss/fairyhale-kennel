<%- include('partials/head') %>
<div class="page-head"><div><h1>My account</h1><p class="muted"><%= user.displayName %> · @<%= user.username %> · <%= user.role %></p></div></div>
<div class="card" style="max-width:480px">
  <h2>Change password</h2>
  <% if (error) { %><div class="errors"><%= error %></div><% } %>
  <form method="post" action="/account/password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label>Current password</label><input type="password" name="current" autocomplete="current-password" required></div>
    <div><label>New password</label><input type="password" name="password" autocomplete="new-password" minlength="10" required><div class="help">At least 10 characters.</div></div>
    <div><label>Confirm new password</label><input type="password" name="confirm" autocomplete="new-password" required></div>
    <button class="btn">Update password</button>
  </form>
</div>
<%- include('partials/foot') %>
